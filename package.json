{
  "name": "spinejs",
  "version": "0.1.0",
  "description": "A standalone browser UI framework with explicit state subscriptions and direct DOM bindings.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackrizza/spinejs.git"
  },
  "private": true,
  "files": [
    "dist/spine.js",
    "dist/spine.min.js",
    "dist/spine.min.js.map",
    "docs/using-spine.md"
  ],
  "exports": {
    "./spine.js": "./dist/spine.js",
    "./spine.min.js": "./dist/spine.min.js",
    "./spine.min.js.map": "./dist/spine.min.js.map"
  },
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "node scripts/build.cjs",
    "build:framework": "node scripts/build.cjs --framework",
    "prepack": "npm run build:framework",
    "preview": "http-server dist -a 127.0.0.1 -c-1",
    "test": "node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "http-server": "^14.1.1",
    "jsdom": "^30.1.3",
    "terser": "^5.51.2"
  }
}
